# ============================================================================
# .env.dokploy.example
# Copiar este contenido en la sección "Environment Variables" de Dokploy
# y completar los valores marcados con < >
# ============================================================================

# ----------------------------------------------------------------------------
# MONGODB ATLAS (requerido)
# Obtener desde: Atlas → tu clúster → Connect → Drivers → Python
# ----------------------------------------------------------------------------
MONGODB_URL=mongodb+srv://<usuario>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority&appName=<AppName>
MONGODB_DB=Arandanos

# ----------------------------------------------------------------------------
# JWT — Autenticación del dashboard (requerido)
# Generar un secreto aleatorio: openssl rand -hex 32
# ----------------------------------------------------------------------------
JWT_SECRET=<secreto-largo-y-aleatorio>
JWT_ACCESS_MINUTES_ADMIN=30
JWT_ACCESS_HOURS_EMPLOYEE=8
JWT_REFRESH_DAYS=7
AUTH_DEMO_PASSWORD=<password-demo-usuarios>

# ----------------------------------------------------------------------------
# SUPABASE — Autenticación de usuarios (requerido si se usa Supabase)
# Obtener desde: supabase.com → tu proyecto → Settings → API
# ----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://<project-id>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-key>

# ----------------------------------------------------------------------------
# FRONTEND — imagen pre-buildeada (para docker-compose.dokploy.prebuilt.yml)
# Buildear localmente con build-push-frontend.ps1 y subir a Docker Hub.
# VITE_API_URL vacío → nginx interno redirige /api → backend.
# ----------------------------------------------------------------------------
FRONTEND_IMAGE=<tu-usuario-dockerhub>/arandanos-frontend:latest
VITE_API_URL=
VITE_DATA_MODE=real
SIMULATED_DATA_ENABLED=false

# ----------------------------------------------------------------------------
# MAILERSEND — Alertas por email (opcional)
# Obtener desde: app.mailersend.com → API Tokens
# ----------------------------------------------------------------------------
MAILERSEND_API_TOKEN=
MAILERSEND_FROM_EMAIL=
MAILERSEND_FROM_NAME=Monitoreo Embalse Arandanos
MAILERSEND_TO_EMAILS=
MAILERSEND_TEMPLATE_ID=
