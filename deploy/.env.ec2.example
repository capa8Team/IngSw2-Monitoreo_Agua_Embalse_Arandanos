# Copiar a la raíz del repo como .env en la instancia EC2:
#   cp deploy/.env.ec2.example .env
#   nano .env

# --- Supabase (obligatorio para login y panel admin) ---
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
SUPABASE_DB_URL=postgresql+psycopg2://postgres:PASSWORD@db.xxxxx.supabase.co:5432/postgres

# Frontend: dejar vacío para que nginx del contenedor proxy /api → backend
VITE_API_URL=
VITE_DATA_MODE=real

# --- Seguridad (cambiar todos en producción) ---
JWT_SECRET=genera-un-secreto-largo-aleatorio-min-32-chars
MONGO_ROOT_PASSWORD=password-mongo-muy-fuerte
AUTH_DEMO_PASSWORD=

# --- MongoDB ---
MONGODB_DB=Arandanos

# --- AWS IoT Core (certificados en IotCore/, no están en git) ---
AWS_IOT_ENABLED=true
AWS_IOT_ENDPOINT=a319gtmfe1r2jb-ats.iot.sa-east-1.amazonaws.com
AWS_IOT_CLIENT_ID=embalse-backend
AWS_IOT_TOPIC=boya/sensores
AWS_IOT_CERTS_DIR=./IotCore

# --- Alertas email (opcional) ---
MAILERSEND_API_TOKEN=
MAILERSEND_FROM_EMAIL=
MAILERSEND_FROM_NAME=Monitoreo Embalse Arandanos
MAILERSEND_TO_EMAILS=

# ID de plantilla en MailerSend (variables: DEVICE_NAME, DAY_NAME, FECHA, HORA, SENSOR, MEDICION)
MAILERSEND_TEMPLATE_ID=351ndgw8m7rgzqx8

# --- Telegram (opcional; ver docs/GUIA_DESPLIEGUE_TELEGRAM.md) ---
TELEGRAM_BOT_TOKEN=
PUBLIC_BASE_URL=https://tu-dominio-o-ip-publica
WEBAPP_URL=https://tu-dominio-o-ip-publica/webapp/
