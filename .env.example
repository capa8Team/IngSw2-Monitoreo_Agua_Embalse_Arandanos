TELEGRAM_BOT_TOKEN=
PUBLIC_BASE_URL=https://example.ngrok-free.app
WEBAPP_URL=https://example.ngrok-free.app/webapp/

# Supabase Configuration (AUTENTICACION + gestión de usuarios admin)
# Copia este archivo a .env en la raíz (no se sube a git) y pega URL + anon key desde:
# Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
# El admin del panel debe existir en Supabase Auth con la misma contraseña que usa en /login
# (p. ej. admin@test.com). Tras cambiar .env: reinicia `npm run dev`.

# API del backend (build/deploy del frontend, p. ej. Dokploy)
VITE_API_URL=https://api.tu-dominio.com

# Supabase Postgres (logs de login + actividad de cuentas admin)
# Directa (Supabase → Database → URI):
# postgresql+psycopg2://postgres:TU_PASSWORD@db.TU_PROYECTO.supabase.co:5432/postgres
# Si Docker no resuelve db.*.supabase.co (error 500 en actividad), usa el pooler:
# Supabase → Database → Connection string → «Session pooler» (puerto 5432):
# SUPABASE_DB_POOLER_URL=postgresql+psycopg2://postgres.TU_PROYECTO:TU_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres
# Si la contraseña tiene caracteres especiales, codifícala en URL (* → %2A, etc.)
SUPABASE_DB_URL=
SUPABASE_DB_POOLER_URL=
# Docker / IPv4: convierte la URI directa al Session pooler (recomendado)
# SUPABASE_DB_POOLER_URL=postgresql+psycopg2://postgres.TU_PROYECTO:PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres
SUPABASE_DB_USE_POOLER=1
SUPABASE_DB_POOLER_PREFIX=aws-1
SUPABASE_DB_POOLER_REGION=us-west-2
# Si Docker falla con IPv6 (Network is unreachable), ejecuta scripts/resolve-supabase-ipv4.ps1 y usa:
# SUPABASE_DB_HOSTADDR=35.x.x.x

# App mode: real | simulated  (controla el frontend — ver src/services/ArduinoConfig.js)
VITE_DATA_MODE=simulated

# =============================================================================
# Docker Compose (opcional; copiar a .env en la raíz del repo)
# =============================================================================
# BACKEND_PORT=8000
# FRONTEND_PORT=5173
# MONGO_PORT=27017
# MONGO_ROOT_PASSWORD=Panconpalta1
# MONGODB_DB=Arandanos
#
# AWS IoT Core (ReciberConPostMQTT → topic boya/sensores; certificados en IotCore/)
# AWS_IOT_ENABLED=true
# AWS_IOT_ENDPOINT=a319gtmfe1r2jb-ats.iot.sa-east-1.amazonaws.com
# AWS_IOT_CLIENT_ID=embalse-backend
# AWS_IOT_TOPIC=boya/sensores
# AWS_IOT_CERTS_DIR=./IotCore
# JWT_SECRET=cambiar_por_secreto_largo_y_aleatorio
# AUTH_DEMO_PASSWORD=123456789
#
# Dejar VITE_API_URL vacío en Docker: el frontend usa /api/... y nginx reenvía al backend.
# VITE_API_URL=

# OpenWeather
OPENWEATHER_API_KEY=

# Redis (caché cache-aside para lecturas de sensores y dashboard)
# Docker Compose: redis://redis:6379/0
REDIS_URL=redis://localhost:6379/0